; Darkroom Night Vision for Windows 10/11.
; install.ps1 fills in {{WALLPAPER}} with the installed wallpaper path.

[Theme]
DisplayName=Darkroom Night Vision

[Control Panel\Desktop]
Wallpaper={{WALLPAPER}}
TileWallpaper=0
WallpaperStyle=10
Pattern=

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC4D40000
SystemMode=Dark
AppMode=Dark

[MasterThemeSelector]
MTSM=RJSPBS
