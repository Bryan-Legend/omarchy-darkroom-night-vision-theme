  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "#5c0000", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#d40000" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "#800000" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#9c0000" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#c80000" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#c80000" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#a80000" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#960000", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.other.constant"], "settings": { "foreground": "#b80000" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#e00000" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#cc0000" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#d40000" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#a40000", "fontStyle": "italic" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#b00000" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator", "meta.attribute"], "settings": { "foreground": "#ac0000" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key", "variable.other.property"], "settings": { "foreground": "#960000" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ff0000", "fontStyle": "underline" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#ff0000", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#cc0000", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#d40000", "fontStyle": "underline" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#c00000" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#700000", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#c00000", "fontStyle": "italic" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ff0000" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#b80000" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#960000", "italic": true },
    "property": "#960000",
    "enumMember": "#c80000",
    "*.deprecated": { "strikethrough": true }
  }
}
